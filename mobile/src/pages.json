{
	"easycom": {
		"autoscan": true,
		"custom": {
			"^wd-(.*)": "@wot-ui/ui/components/wd-$1/wd-$1.vue"
		}
	},
	"pages": [
		{
			"path": "pages/login/login",
			"style": {
				"navigationStyle": "custom",
				"navigationBarTitleText": "登录"
			}
		},
		{
			"path": "pages/index/index",
			"style": {
				"navigationStyle": "custom",
				"navigationBarTitleText": "我的工单",
				"enablePullDownRefresh": true
			}
		},
		{
			"path": "pages/master/index",
			"style": {
				"navigationStyle": "custom",
				"navigationBarTitleText": "师傅工作台",
				"enablePullDownRefresh": true
			}
		},
		{
			"path": "pages/master/detail",
			"style": {
				"navigationStyle": "custom",
				"navigationBarTitleText": "工单详情"
			}
		},
		{
			"path": "pages/order/create",
			"style": {
				"navigationStyle": "custom",
				"navigationBarTitleText": "提交报修"
			}
		},
		{
			"path": "pages/order/edit",
			"style": {
				"navigationStyle": "custom",
				"navigationBarTitleText": "修改报修"
			}
		},
		{
			"path": "pages/order/detail",
			"style": {
				"navigationStyle": "custom",
				"navigationBarTitleText": "工单详情"
			}
		},
		{
			"path": "pages/login/register",
			"style": {
				"navigationStyle": "custom",
				"navigationBarTitleText": "注册"
			}
		},
		{
			"path": "pages/user/profile",
			"style": {
				"navigationStyle": "custom",
				"navigationBarTitleText": "个人中心"
			}
		}
	],
	"globalStyle": {
		"navigationBarTextStyle": "black",
		"navigationBarTitleText": "报修工单",
		"navigationBarBackgroundColor": "#F8F8F8",
		"backgroundColor": "#F8F8F8"
	}
}
